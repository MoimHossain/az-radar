# --- Stage 1: Build React frontend ---
FROM node:20-alpine AS frontend-build
ARG CACHE_BUST=1
WORKDIR /app/ui
ENV NPM_CONFIG_REGISTRY=https://packagefeedproxy.microsoft.io/npm/
COPY src/az-radar-ui/package*.json ./
RUN npm ci
COPY src/az-radar-ui/ ./
RUN npm run build

# --- Stage 2: Build .NET API ---
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS api-build
ARG CACHE_BUST=1
ARG NUGET_SOURCE=https://api.nuget.org/v3/index.json
WORKDIR /src
COPY AzRadar.slnx ./
COPY src/AzRadar.Shared/AzRadar.Shared.csproj src/AzRadar.Shared/
COPY src/AzRadar.Api/AzRadar.Api.csproj src/AzRadar.Api/
RUN dotnet restore src/AzRadar.Api/AzRadar.Api.csproj --source "$NUGET_SOURCE"
COPY src/AzRadar.Shared/ src/AzRadar.Shared/
COPY src/AzRadar.Api/ src/AzRadar.Api/
RUN dotnet publish src/AzRadar.Api/AzRadar.Api.csproj --no-restore -c Release -o /app/publish
RUN test -x /app/publish/runtimes/linux-x64/native/copilot \
    && test -f /app/publish/runtimes/linux-x64/native/runtime.node \
    && mkdir -p /app/publish/third-party \
    && find src/AzRadar.Shared/obj -path '*copilot-cli*/LICENSE.md' -exec cp {} /app/publish/third-party/Copilot-CLI-LICENSE.md \; \
    && test -s /app/publish/third-party/Copilot-CLI-LICENSE.md \
    && curl -fsSL https://raw.githubusercontent.com/github/copilot-sdk/v1.0.22/LICENSE \
       -o /app/publish/third-party/GitHub.Copilot.SDK-LICENSE

# --- Stage 3: Runtime ---
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=api-build /app/publish .
COPY --from=frontend-build /app/ui/dist ./wwwroot/

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "AzRadar.Api.dll"]
