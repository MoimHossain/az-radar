{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.20/MicrosoftTeams.schema.json",
  "manifestVersion": "1.20",
  "version": "1.0.1",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "CloudLens",
    "websiteUrl": "https://github.com/MoimHossain/az-radar",
    "privacyUrl": "https://github.com/MoimHossain/az-radar",
    "termsOfUseUrl": "https://github.com/MoimHossain/az-radar"
  },
  "name": {
    "short": "CloudLens Alerts",
    "full": "CloudLens Azure Service Health Alerts"
  },
  "description": {
    "short": "Routes centrally governed Azure Service Health alerts.",
    "full": "Receives Azure Service Health incidents, maintenance, health advisories, and security advisories from CloudLens and posts administrator-selected event families to this Teams channel."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": [
        "team"
      ],
      "isNotificationOnly": false,
      "supportsFiles": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
